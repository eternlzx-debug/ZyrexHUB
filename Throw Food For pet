-- === LOOP LOGIC SKRIP ===

task.spawn(function()
    while true do
        task.wait(0.2)
        if runningTap then
            pcall(function()
                for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                    if (gui:IsA("ImageButton") or gui:IsA("TextButton")) and gui.Visible then
                        local isTarget = false
                        local name = gui.Name:lower()
                        if name:find("tapbonus") or name:find("training_tap") or name:find("x2") or name:find("2x") then
                            if gui.AbsoluteSize.X > 20 and gui.AbsoluteSize.X < 150 and gui.AbsoluteSize.Y > 20 and gui.AbsoluteSize.Y < 150 then
                                isTarget = true
                            end
                        end
                        if isTarget then
                            pcall(function()
                                if firesignal then
                                    firesignal(gui.Activated)
                                    firesignal(gui.MouseButton1Click)
                                end
                            end)
                            break
                        end
                    end
                end
            end)
        end
    end
end)

task.spawn(function()
    local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
    if not Remotes then return end
    local ThrowStart = Remotes:WaitForChild("Throw_Start", 5)
    local ThrowMeter = Remotes:WaitForChild("Throw_MeterStarted", 5)
    local ThrowResolve = Remotes:WaitForChild("Throw_Resolve", 5)
    local ThrowComplete = Remotes:WaitForChild("Throw_Complete", 5)
    while true do
        task.wait(0.4) 
        if runningSteal and savedPadCFrame then
            task.spawn(function()
                pcall(function()
                    ThrowStart:InvokeServer()
                    task.wait(0.05) 
                    ThrowMeter:FireServer()
                    task.wait(0.05)
                    ThrowResolve:InvokeServer(1) 
                    task.wait(0.05)
                    ThrowComplete:InvokeServer() 
                end)
            end)
        end
    end
end)

