    sec.Parent = Content
end

local function CreateToggle(titleText, callback)
    local tFrame = Instance.new("Frame")
    tFrame.Size = UDim2.new(1, -15, 0, 38)
    tFrame.BackgroundColor3 = Color3.fromRGB(30, 20, 25)
    tFrame.BackgroundTransparency = 0.4
    tFrame.Parent = Content
    Instance.new("UICorner", tFrame).CornerRadius = UDim.new(0, 8)
    
    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(0.7, 0, 1, 0)
    tLabel.Position = UDim2.new(0, 15, 0, 0)
    tLabel.BackgroundTransparency = 1
    tLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    tLabel.TextSize = 13
    tLabel.Font = Enum.Font.GothamSemibold
    tLabel.Text = titleText
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = tFrame
    
    local SwitchBase = Instance.new("TextButton")
    SwitchBase.Size = UDim2.new(0, 42, 0, 22)
    SwitchBase.Position = UDim2.new(1, -55, 0.5, -11)
    SwitchBase.BackgroundColor3 = Color3.fromRGB(50, 40, 45) 
    SwitchBase.Text = ""
    SwitchBase.Parent = tFrame
    Instance.new("UICorner", SwitchBase).CornerRadius = UDim.new(1, 0) 
    
    local SwitchCircle = Instance.new("Frame")
    SwitchCircle.Size = UDim2.new(0, 18, 0, 18)
    SwitchCircle.Position = UDim2.new(0, 2, 0.5, -9) 
    SwitchCircle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    SwitchCircle.Parent = SwitchBase
    Instance.new("UICorner", SwitchCircle).CornerRadius = UDim.new(1, 0)

    local state = false
    SwitchBase.MouseButton1Click:Connect(function()
        state = not state
        local targetColor = state and Color3.fromRGB(255, 50, 100) or Color3.fromRGB(50, 40, 45)
        local targetPos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        local circleColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        
        TweenService:Create(SwitchBase, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(SwitchCircle, TweenInfo.new(0.2), {Position = targetPos, BackgroundColor3 = circleColor}):Play()
        callback(state)
    end)
end

-- === MENGISI KONTEN UI ===
CreateSection("Main Farm")
CreateToggle("Auto Tap x2", function(state) runningTap = state end)
CreateToggle("Auto Steal Pet", function(state)
    runningSteal = state
    if runningSteal then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            savedPadCFrame = char.HumanoidRootPart.CFrame
        end
        StealIndicator.Visible = true 
        if not cframeLockConnection then
            cframeLockConnection = RunService.Heartbeat:Connect(function()
                if runningSteal and savedPadCFrame then
                    local currentChar = LocalPlayer.Character
                    if currentChar and currentChar:FindFirstChild("HumanoidRootPart") then
                        currentChar.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        currentChar.HumanoidRootPart.CFrame = savedPadCFrame
                    end
                end
            end)
        end
    else
        StealIndicator.Visible = false 
        if cframeLockConnection then
            cframeLockConnection:Disconnect()
            cframeLockConnection = nil
        end
    end
end)

