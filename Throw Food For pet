task.spawn(function()
    local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    if not Remotes then return end
    local ThrowStart = Remotes:WaitForChild("Throw_Start", 10)
    local ThrowMeter = Remotes:WaitForChild("Throw_MeterStarted", 10)
    local ThrowResolve = Remotes:WaitForChild("Throw_Resolve", 10)
    local ThrowComplete = Remotes:WaitForChild("Throw_Complete", 10)
    local lastCycleTick = tick()

    while true do
        if runningSteal then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not savedPadCFrame then savedPadCFrame = hrp.CFrame end
                if (tick() - lastCycleTick) > 3.5 then
                    pcall(function() ThrowComplete:InvokeServer() end)
                    hrp.CFrame = savedPadCFrame
                    lastCycleTick = tick()
                    task.wait(0.2)
                end

                catchNotifiedThisCycle = false
                local beforeTools = SnapshotOwnedTools()

                local ok = pcall(function()
                    if ThrowStart:InvokeServer() == false then
                        ThrowComplete:InvokeServer()
                        task.wait(0.15)
                        ThrowStart:InvokeServer()
                    end
                    task.wait(0.08)
                    if not runningSteal then return end
                    ThrowMeter:FireServer()
                    task.wait(0.08)
                    if not runningSteal then return end
                    local resolveRes = ThrowResolve:InvokeServer(1)
                    task.wait(0.08)
                    if not runningSteal then return end
                    local completeRes = ThrowComplete:InvokeServer()

                    lastCycleTick = tick()
                    task.wait(0.12)

                    local parsed = ParseThrowResult(resolveRes, completeRes)
                    if parsed then
                        RegisterVerifiedCatch(parsed)
                    else
                        local newTool = FindNewlyAddedTool(beforeTools)
                        if newTool then
                            local petName = newTool:GetAttribute("DisplayName") or newTool:GetAttribute("AnimalName") or newTool.Name
                            local mTxt, sTxt, rTxt = DetectTraitsFromString(petName)
                            local weight = newTool:GetAttribute("Weight")
                            local cps = newTool:GetAttribute("CPS") or newTool:GetAttribute("CashPerSecond")
                            RegisterVerifiedCatch({
                                title = tostring(petName) .. " Obtained!",
                                mutation = newTool:GetAttribute("Mutation") or newTool:GetAttribute("Variant") or mTxt or "Normal",
                                size = newTool:GetAttribute("Size") or newTool:GetAttribute("Scale") or sTxt or "Normal",
                                rarity = newTool:GetAttribute("Rarity") or newTool:GetAttribute("Tier") or rTxt or "Common",
                                weight = weight and (tostring(weight) .. " kg") or "-",
                                cps = cps and ("$" .. FormatShortNumber(cps) .. "/s") or "-"
                            })
                        end
                    end
                end)

                if not ok then
                    pcall(function() ThrowComplete:InvokeServer() end)
                    task.wait(0.3)
                else
                    task.wait(0.25)
                end
            else
                task.wait(0.3)
            end
        else
            lastCycleTick = tick()
            task.wait(0.25)
        end
    end
end)

