local function RegisterVerifiedCatch(catchData)
    if catchNotifiedThisCycle or (tick() - lastCatchTick) < 0.7 then return end
    catchNotifiedThisCycle = true
    lastCatchTick = tick()
    totalStealCount += 1
    StealIndicator.Text = "STEALING ACTIVE (" .. totalStealCount .. ")"
    ShowTieredNotif(catchData)
end

local function ParseThrowResult(res1, res2)
    local data = (type(res2) == "table" and res2) or (type(res1) == "table" and res1) or nil
    if data then
        local pet = data.Animal or data.Pet or data.Reward or data.Data or data
        if type(pet) == "table" then
            local name = pet.Name or pet.AnimalName or pet.PetName or pet.Id or pet.ID
            if name then
                local mTxt, sTxt, rTxt = DetectTraitsFromString(name)
                local rawWeight = pet.Weight or pet.Mass
                local rawCps = pet.CPS or pet.CashPerSecond or pet.Income or pet.Rate
                return {
                    title = tostring(name) .. " Obtained!",
                    mutation = pet.Mutation or pet.Variant or mTxt or "Normal",
                    size = pet.Size or pet.Scale or sTxt or "Normal",
                    rarity = pet.Rarity or pet.Tier or rTxt or "Common",
                    weight = rawWeight and (tostring(rawWeight) .. ((tostring(rawWeight):find("kg") or tostring(rawWeight):find("t")) and "" or " kg")) or "-",
                    cps = rawCps and ("$" .. FormatShortNumber(rawCps) .. "/s") or "-"
                }
            end
        end
    elseif (type(res2) == "string" and #res2 > 1) or (type(res1) == "string" and #res1 > 1) then
        local rawName = (type(res2) == "string" and #res2 > 1) and res2 or res1
        local mTxt, sTxt, rTxt = DetectTraitsFromString(rawName)
        return {
            title = rawName .. " Obtained!",
            mutation = mTxt or "Normal",
            size = sTxt or "Normal",
            rarity = rTxt or "Common",
            weight = "-",
            cps = "-"
        }
    end
    return nil
end

