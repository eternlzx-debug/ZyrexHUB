-- === FORMATTER ANGKA (CPS / UANG) ===
local function FormatShortNumber(num)
    if type(num) ~= "number" then return tostring(num) end
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
    local idx = 1
    while math.abs(num) >= 1000 and idx < #suffixes do
        num = num / 1000
        idx = idx + 1
    end
    if idx == 1 then
        return tostring(math.floor(num))
    end
    return string.format("%.2f%s", num, suffixes[idx]):gsub("%.00", "")
end

