-- === PARSER DATA HASIL THROW DARI SERVER ===
local function ParseThrowResult(res1, res2)
    local data = (type(res2) == "table" and res2) or (type(res1) == "table" and res1) or nil
    if data then
        local petInfo = data.Animal or data.Pet or data.Reward or data.Data or data
        if type(petInfo) == "table" then
            local petName = petInfo.Name or petInfo.AnimalName or petInfo.PetName or petInfo.Id or petInfo.ID
            if petName then
                local mutation = tostring(petInfo.Mutation or petInfo.Variant or "None")
                local rawWeight = petInfo.Weight or petInfo.Mass or petInfo.Size
                local weightStr = rawWeight and (tostring(rawWeight) .. ((tostring(rawWeight):find("kg") or tostring(rawWeight):find("t")) and "" or " kg")) or "-"
                local rawCps = petInfo.CPS or petInfo.CashPerSecond or petInfo.Income or petInfo.Rate
                local cpsStr = rawCps and ("$" .. FormatShortNumber(rawCps) .. "/s") or "-"
                return tostring(petName) .. " Obtained!", string.format("Mutation: %s | Weight: %s | CPS: %s", mutation, weightStr, cpsStr)
            end
        end
    elseif type(res2) == "string" and #res2 > 1 then
        return res2 .. " Obtained!", "Berhasil ditangkap oleh Auto Steal"
    elseif type(res1) == "string" and #res1 > 1 then
        return res1 .. " Obtained!", "Berhasil ditangkap oleh Auto Steal"
    end
    return nil, nil
end

