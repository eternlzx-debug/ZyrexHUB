-- Loop 2: Smart Sequential Auto Steal + Single Verified Notification
task.spawn(function()
    local Remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    if not Remotes then return end
    local ThrowStart = Remotes:WaitForChild("Throw_Start", 10)
    local ThrowMeter = Remotes:WaitForChild("Throw_MeterStarted", 10)
    local ThrowResolve = Remotes:WaitForChild("Throw_Resolve", 10)
    local ThrowComplete = Remotes:WaitForChild("Throw_Complete", 10)

    local lastCycleTick = tick()

    while true do
        if runningSteal then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hrp then
                if not savedPadCFrame then
                    savedPadCFrame = hrp.CFrame
                end

                -- Watchdog pemulihan otomatis jika siklus macet > 3.5 detik
                if (tick() - lastCycleTick) > 3.5 then
                    pcall(function() ThrowComplete:InvokeServer() end)
                    hrp.CFrame = savedPadCFrame
                    lastCycleTick = tick()
                    task.wait(0.2)
                end

                -- Reset flag notifikasi & simpan daftar item sebelum melempar
                catchNotifiedThisCycle = false
                local beforeTools = SnapshotOwnedTools()

                local ok = pcall(function()
                    local startRes = ThrowStart:InvokeServer()
                    if startRes == false then
                        ThrowComplete:InvokeServer()
                        task.wait(0.15)
                        startRes = ThrowStart:InvokeServer()
                    end

                    task.wait(0.08)
                    if not runningSteal then return end
                    ThrowMeter:FireServer()

                    task.wait(0.08)
                    if not runningSteal then return end
                    local resolveRes = ThrowResolve:InvokeServer(1)

                    task.wait(0.08)
                    if not runningSteal then return end
                    local completeRes = ThrowComplete:InvokeServer()

                    lastCycleTick = tick()

                    -- Tunggu singkat agar replikasi Backpack / GUI selesai
                    task.wait(0.12)

                    -- Hanya tampilkan 1x notifikasi jika benar-benar ada pet yang tertangkap
                    local notifTitle, notifDetail = ParseThrowResult(resolveRes, completeRes)
                    if notifTitle then
                        RegisterVerifiedCatch(notifTitle, notifDetail)
                    else
                        local newTool = FindNewlyAddedTool(beforeTools)
                        if newTool then
                            local petName = newTool:GetAttribute("DisplayName") or newTool:GetAttribute("AnimalName") or newTool.Name
                            local mutation = tostring(newTool:GetAttribute("Mutation") or "None")
                            local weight = newTool:GetAttribute("Weight")
                            local cps = newTool:GetAttribute("CPS") or newTool:GetAttribute("CashPerSecond")
                            local detail = string.format(
                                "Mutation: %s | Weight: %s | CPS: %s",
                                mutation,
                                weight and (tostring(weight) .. " kg") or "-",
                                cps and ("$" .. FormatShortNumber(cps) .. "/s") or "-"
                            )
                            RegisterVerifiedCatch(tostring(petName) .. " Obtained!", detail)
                        end
                    end
                end)

                if not ok then
                    pcall(function() ThrowComplete:InvokeServer() end)
                    task.wait(0.3)
                else
                    task.wait(0.25)
                end
            else
                task.wait(0.3)
            end
        else
            lastCycleTick = tick()
            task.wait(0.25)
        end
    end
end)

