guiAddedConnection = LocalPlayer.PlayerGui.DescendantAdded:Connect(function(desc)
    if not runningSteal or not desc:IsA("TextLabel") then return end
    task.defer(function()
        task.wait(0.05)
        if not desc or not desc.Parent then return end
        local txt = desc.Text
        if type(txt) ~= "string" or txt == "" then return end

        if txt:find("Obtained!") then
            local mTxt, sTxt, rTxt = DetectTraitsFromString(txt)
            local weightStr, cpsStr = "-", "-"
            for _, sib in ipairs(desc.Parent:GetChildren()) do
                if sib:IsA("TextLabel") and sib ~= desc then
                    local st = sib.Text
                    local sm, ss, sr = DetectTraitsFromString(st)
                    mTxt = mTxt or sm
                    sTxt = sTxt or ss
                    rTxt = rTxt or sr
                    local wMatch = st:match("Weight:%s*([^|]+)")
                    local cMatch = st:match("CPS:%s*([^|]+)")
                    if wMatch then weightStr = wMatch:gsub("%s+$", "") end
                    if cMatch then cpsStr = cMatch:gsub("%s+$", "") end
                end
            end
            RegisterVerifiedCatch({
                title = txt,
                mutation = mTxt or "Normal",
                size = sTxt or "Normal",
                rarity = rTxt or "Common",
                weight = weightStr,
                cps = cpsStr
            })
        elseif txt:lower():find("plot is full") and (tick() - lastPlotFullTick) > 5 then
            lastPlotFullTick = tick()
            ShowTieredNotif({
                compact = true,
                title = "Plot Penuh!",
                detail = txt,
                customColor = Color3.fromRGB(255, 80, 80)
            })
        end
    end)
end)

local function SnapshotOwnedTools()
    local items = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, v in ipairs(bp:GetChildren()) do items[v] = true end end
    local char = LocalPlayer.Character
    if char then for _, v in ipairs(char:GetChildren()) do if v:IsA("Tool") then items[v] = true end end end
    return items
end

local function FindNewlyAddedTool(beforeSnapshot)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, v in ipairs(bp:GetChildren()) do if not beforeSnapshot[v] then return v end end end
    local char = LocalPlayer.Character
    if char then for _, v in ipairs(char:GetChildren()) do if v:IsA("Tool") and not beforeSnapshot[v] then return v end end end
    return nil
end

