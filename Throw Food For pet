local function FormatShortNumber(num)
    if type(num) ~= "number" then return tostring(num) end
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Udc", "Ddc", "Tdc", "Ocd"}
    local idx = 1
    while math.abs(num) >= 1000 and idx < #suffixes do
        num = num / 1000
        idx = idx + 1
    end
    return idx == 1 and tostring(math.floor(num)) or (string.format("%.2f%s", num, suffixes[idx]):gsub("%.00", ""))
end

local function MatchTier(tbl, rawVal, fallbackKey)
    if rawVal then
        local clean = tostring(rawVal):lower():gsub("[%s_%-%[%]]", "")
        for key, info in pairs(tbl) do
            if clean == key or clean:find(key, 1, true) then
                return key, info
            end
        end
    end
    return fallbackKey, tbl[fallbackKey]
end

local function DetectTraitsFromString(str)
    local lower = tostring(str or ""):lower()
    local mutKey, sizeKey, rarKey = nil, nil, nil
    for k in pairs(MUTATION_TIERS) do
        if k ~= "normal" and lower:find(k, 1, true) then mutKey = k break end
    end
    for k in pairs(SIZE_TIERS) do
        if k ~= "normal" and k ~= "cosmic" and lower:find(k, 1, true) then sizeKey = k break end
    end
    for k in pairs(RARITY_TIERS) do
        if lower:find(k, 1, true) then rarKey = k break end
    end
    return mutKey, sizeKey, rarKey
end

