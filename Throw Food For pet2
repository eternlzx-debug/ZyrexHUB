-- === SMART ANTI-SPAM BUY FOOD LOGIC ===
local function TrySingleFoodBuy(index)
    if not ShopBuyRemote then return false end
    insufficientCashFlag = false
    local ok, res = pcall(function()
        return ShopBuyRemote:InvokeServer(index)
    end)
    task.wait(0.16) -- Beri waktu singkat agar server merespons jika uang tidak cukup
    if insufficientCashFlag or (tick() - lastInsufficientTick) < 0.35 then
        return false
    end
    if ok and res ~= false then
        return true
    end
    return false
end

local function RunSmartFoodCycle()
    if not runningFood or not ShopBuyRemote then return end

    -- Jika sedang menunggu uang cukup, jangan spam beli!
    if foodWaitingForCash then
        return
    end

    PerformMicroStepWakeup()

    -- Kasus 1: Sudah tahu tier makanan terbaik yang terjangkau
    if bestAffordableFoodIdx then
        -- Cek 1 kali apakah naik 1 tier di atasnya sudah kebeli
        if bestAffordableFoodIdx < 60 then
            if TrySingleFoodBuy(bestAffordableFoodIdx + 1) then
                bestAffordableFoodIdx += 1
                if statusFoodLbl then
                    statusFoodLbl.Text = "Status: Berhasil beli Food Tier #" .. bestAffordableFoodIdx
                end
                return
            end
        end

        -- Beli tier terbaik saat ini (1 kali saja)
        insufficientCashFlag = false
        if TrySingleFoodBuy(bestAffordableFoodIdx) then
            if statusFoodLbl then
                statusFoodLbl.Text = "Status: Membeli Food Tier #" .. bestAffordableFoodIdx
            end
        else
            -- Gagal / Tidak cukup uang -> langsung kunci tanpa spam!
            foodWaitingForCash = true
            if statusFoodLbl then
                statusFoodLbl.Text = "Status: Menunggu uang cukup (Anti-Spam aktif)"
            end
        end
        return
    end

    -- Kasus 2: Pencarian pertama kali untuk menemukan makanan tertinggi yang sanggup dibeli
    for i = 60, 1, -1 do
        if not runningFood then return end
        if TrySingleFoodBuy(i) then
            bestAffordableFoodIdx = i
            if statusFoodLbl then
                statusFoodLbl.Text = "Status: Terkunci di Food Tier #" .. i
            end
            return
        end
        -- Jika di tier 1 saja tidak cukup uang, langsung pause!
        if i == 1 then
            foodWaitingForCash = true
            if statusFoodLbl then
                statusFoodLbl.Text = "Status: Menunggu uang cukup (Anti-Spam aktif)"
            end
        end
    end
end

-- === SMART ANTI-SPAM UPGRADE STAND LOGIC ===
local function RunSmartStandCycle()
    if not runningUpgrade or not StandUpgradeRemote then return end
    if standWaitingForCash then return end

    PerformMicroStepWakeup()

    insufficientCashFlag = false
    local ok, res = pcall(function()
        return StandUpgradeRemote:InvokeServer()
    end)
    task.wait(0.18)

    if insufficientCashFlag or (tick() - lastInsufficientTick) < 0.35 or (ok and res == false) then
        standWaitingForCash = true
        if statusStandLbl then
            statusStandLbl.Text = "Status: Menunggu uang cukup (Anti-Spam aktif)"
        end
    else
        if statusStandLbl then
            statusStandLbl.Text = "Status: Stand upgraded! Siap cek berikutnya"
        end
    end
end

