    local ok, res = FireOrInvoke(RebirthRemote)
    task.wait(0.25)
    if ok and res ~= false and beforeCash and lastNumericCash and lastNumericCash < (beforeCash * 0.2) then
        ResetSmartBuyState()
        ShowNotif("Rebirth Sukses!", "Smart Buy Food & Stand di-reset ke Tier awal.", THEME.Gold, false)
    end
end

