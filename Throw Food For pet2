local function RegisterVerifiedCatch(titleText, detailText)
    if catchNotifiedThisCycle or (tick() - lastCatchTick) < 0.75 then
        if lastCatchNotifRef and lastCatchNotifRef.detailLbl and lastCatchNotifRef.detailLbl.Parent then
            if detailText and detailText ~= "" and #detailText > #lastCatchNotifRef.detail then
                lastCatchNotifRef.detail = detailText
                lastCatchNotifRef.detailLbl.Text = detailText
            end
        end
        return
    end
    catchNotifiedThisCycle = true
    lastCatchTick = tick()
    totalStealCount += 1
    StealPill.Text = "⚡ STEALING ACTIVE (" .. totalStealCount .. ")"
    if statStealCountLbl then
        statStealCountLbl.Text = "Total tertangkap sesi ini: " .. totalStealCount .. " Pet"
    end
    local col, rb = ResolveCardStyleFromText(titleText .. " " .. (detailText or ""))
    lastCatchNotifRef = ShowNotif(titleText, detailText, col, rb)
end

-- === PEMANTAU SALDO UANG OTOMATIS (UNLOCK SMART BUY SAAT SALDO NAIK) ===
local function ParseCashValue(str)
    if type(str) ~= "string" then return nil end
    local numPart, suffix = str:match("%$?%s*([%d%.]+)%s*(%a*)")
    local num = tonumber(numPart)
    if not num then return nil end
    local mults = {
        k = 1e3, m = 1e6, b = 1e9, t = 1e12,
        qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24,
        oc = 1e27, no = 1e30, dc = 1e33, udc = 1e36,
        ddc = 1e39, tdc = 1e42, ocd = 1e45
    }
    local m = suffix and mults[suffix:lower()] or 1
    return num * m
end

local lastNumericCash = nil
local function OnCashTextObserved(rawText)
    if not rawText or rawText == "" then return end
    if rawText ~= lastKnownCashSnapshot then
        lastKnownCashSnapshot = rawText
        if statCashLbl then
            statCashLbl.Text = "Saldo terdeteksi: " .. rawText
        end
        local numeric = ParseCashValue(rawText)
        if numeric then
            if lastNumericCash and numeric > lastNumericCash then
                -- Saldo naik! Buka kunci Smart Buy Food & Stand
                foodWaitingForCash = false
                standWaitingForCash = false
                insufficientCashFlag = false
                cashIncreasedSignal = true
            end
            lastNumericCash = numeric
        else
            -- Jika format teks berubah meski bukan angka standar, tetap buka kunci dengan aman
            foodWaitingForCash = false
            standWaitingForCash = false
            cashIncreasedSignal = true
        end
    end
end

-- === LISTENER PLAYERGUI (DIRECT CATCH MIRROR + DETEKSI "TIDAK CUKUP UANG!") ===
table.insert(connections, LocalPlayer.PlayerGui.DescendantAdded:Connect(function(desc)
    if not desc:IsA("TextLabel") then return end

    -- Pantau perubahan teks saldo uang di HUD (contoh: $6.63Td)
    task.defer(function()
        if not desc or not desc.Parent then return end
        local txt = desc.Text
        if type(txt) ~= "string" or txt == "" then return end

        if txt:match("^%$[%d%.]+%a*$") then
            OnCashTextObserved(txt)
            table.insert(connections, desc:GetPropertyChangedSignal("Text"):Connect(function()
                OnCashTextObserved(desc.Text)
            end))
            return
        end

        local lower = txt:lower()

        -- 1. Deteksi notif bawaan game "Tidak cukup uang!" agar Smart Buy langsung berhenti spam
        if lower:find("tidak cukup uang") or lower:find("uang tidak cukup") or lower:find("not enough") or lower:find("insufficient") then
            insufficientCashFlag = true
            lastInsufficientTick = tick()
            if runningFood then
                foodWaitingForCash = true
                if statusFoodLbl then
                    statusFoodLbl.Text = "Status: Menunggu uang cukup (Anti-Spam aktif)"
                end
            end
            if runningUpgrade then
                standWaitingForCash = true
                if statusStandLbl then
                    statusStandLbl.Text = "Status: Menunggu uang cukup (Anti-Spam aktif)"
                end
            end
            return
        end

        -- 2. Direct Mirroring Notif Tangkapan Resmi Game ("Obtained!")
        if runningSteal and txt:find("Obtained!") then
            task.wait(0.08)
            if not desc or not desc.Parent then return end
            local parts = {}
            local scanRoot = desc.Parent
            if scanRoot and scanRoot.Parent and not scanRoot.Parent:IsA("ScreenGui") and not scanRoot.Parent:IsA("PlayerGui") then
                if #scanRoot:GetDescendants() <= 5 then
                    scanRoot = scanRoot.Parent
                end
            end
            if scanRoot then
                for _, child in ipairs(scanRoot:GetDescendants()) do
                    if child:IsA("TextLabel") and child ~= desc and child.Text ~= "" then
                        table.insert(parts, child.Text)
                    end
                end
            end
            local detailStr = (#parts > 0) and table.concat(parts, "  •  ") or "Berhasil masuk ke inventory!"
            RegisterVerifiedCatch(txt, detailStr)
        elseif runningSteal and lower:find("plot is full") and (tick() - lastPlotFullTick) > 5 then
            lastPlotFullTick = tick()
            ShowNotif("Plot Penuh!", txt, Color3.fromRGB(255, 85, 85), false)
        end
    end)
end))

